    replacement_infos {
      original_chunk {
        target_content: "      {/* FOOTER */}\n      <footer className=\"bg-[#1F4E5F] text-white py-12 border-t border-[#1C4351]\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6\">\n          <div className=\"flex items-center justify-center gap-2\">\n            <div className=\"w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-white font-mono font-bold text-xs\">\n              MB\n            </div>\n            <span className=\"font-bold text-base tracking-tight font-display\">{USER_INFO.name}</span>\n          </div>\n\n          <p className=\"text-xs text-slate-300 max-w-lg mx-auto leading-relaxed\">\n            Dise\303\261o corporativo premium para analistas cient\303\255ficos. Implementando mejores pr\303\241cticas de accesibilidad WCAG, responsive fluido mobile-first, y telemetr\303\255a de negocio. \n          </p>\n\n          <div className=\"flex items-center justify-center gap-5 text-slate-400\">\n            <a href={USER_INFO.linkedin} target=\"_blank\" rel=\"noreferrer\" className=\"hover:text-white transition\"><Icons.Linkedin className=\"w-4.5 h-4.5\" /></a>\n            <a href={USER_INFO.github} target=\"_blank\" rel=\"noreferrer\" className=\"hover:text-white transition\"><Icons.Github className=\"w-4.5 h-4.5\" /></a>\n            <a href={`mailto:${USER_INFO.email}`} className=\"hover:text-white transition\"><Icons.Mail className=\"w-4.5 h-4.5\" /></a>\n          </div>\n\n          <div className=\"pt-6 border-t border-[#275d71] text-[10px] text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-4\">\n            <span>\303\232ltima actualizaci\303\263n de queries: Junio, 2026</span>\n            <span>Buenos Aires, Argentina \342\200\242 Todos los Derechos Reservados</span>\n          </div>\n        </div>\n      </footer>"
        replacement_content: "      {/* FOOTER */}\n      <footer className=\"border-t border-[#1F4E5F]/10 bg-white/20 dark:bg-slate-900/40 py-8 backdrop-blur-md\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"flex flex-wrap gap-6 items-center\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse\"></div>\n              <span className=\"text-[10px] font-black uppercase tracking-widest text-[#2D3748] dark:text-slate-300\">Disponible para nuevos proyectos</span>\n            </div>\n            <div className=\"hidden sm:block w-px h-4 bg-[#1F4E5F]/20\"></div>\n            <span className=\"text-[10px] font-mono opacity-70 text-[#2D3748] dark:text-slate-400\">{USER_INFO.email}</span>\n          </div>\n          <div className=\"flex gap-6 text-xs font-black uppercase tracking-widest text-[#2D3748]/60 dark:text-slate-300/60\">\n            <a href={USER_INFO.linkedin} target=\"_blank\" rel=\"noreferrer\" className=\"hover:text-[#1F4E5F] dark:hover:text-sky-300 transition-colors\">LinkedIn</a>\n            <a href={USER_INFO.github} target=\"_blank\" rel=\"noreferrer\" className=\"hover:text-[#1F4E5F] dark:hover:text-sky-300 transition-colors\">GitHub</a>\n            <a href={`mailto:${USER_INFO.email}`} className=\"hover:text-[#1F4E5F] dark:hover:text-sky-305 transition-colors\">Contacto</a>\n          </div>\n        </div>\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 mt-6 border-t border-[#1F4E5F]/10 flex flex-col sm:flex-row items-center justify-between text-[9px] font-mono text-[#2D3748]/50 dark:text-slate-400/50\">\n          <span>\303\232ltima actualizaci\303\263n de queries: Junio, 2026</span>\n          <span>Mateo Beliz\303\241n \302\251 Todos los Derechos Reservados</span>\n        </div>\n      </footer>"
