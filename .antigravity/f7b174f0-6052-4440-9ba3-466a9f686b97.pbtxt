        }
        lines {
          text: "// 2. CHURN SIMULATOR"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// =========================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function ChurnSimulator() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [tenure, setTenure] = useState<number>(12); // months"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [supportTickets, setSupportTickets] = useState<number>(2); // tickets"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [hasContract, setHasContract] = useState<boolean>(true); // contract type"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const riskResult = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Basic logic for simulating ML classifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Tenure reduces risk, tickets increase risk, contract reduces risk significantly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let baseScore = 50;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Contract influence"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!hasContract) baseScore += 25; // month-to-month boosts risk"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    else baseScore -= 20;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Tickets influence"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    baseScore += (supportTickets * 8);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Tenure influence"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    baseScore -= (tenure * 0.9);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Bound between 3% and 98%"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const score = Math.max(3, Math.min(98, Math.round(baseScore)));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let description = \"Riesgo Bajo\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let color = \"bg-emerald-500\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let textColor = \"text-emerald-700\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let bgColor = \"bg-emerald-50\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let border = \"border-emerald-200\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let actionPlaybook = \"Salud \303\223ptima. Fomentar la conversi\303\263n a defensores de marca (NPS Promoters) u ofrecer programa de referidos.\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (score > 65) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      description = \"Riesgo Cr\303\255tico\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      color = \"bg-red-500\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      textColor = \"text-red-700\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      bgColor = \"bg-red-50\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      border = \"border-red-200\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      actionPlaybook = \"Disparar Alerta CSM. Ejecutar playbook inmediato de retenci\303\263n ofreciendo bonificaci\303\263n de renovaci\303\263n y llamada de alineaci\303\263n t\303\251cnica con Product Owner.\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else if (score > 35) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      description = \"Riesgo Moderado\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      color = \"bg-amber-500\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      textColor = \"text-amber-700\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      bgColor = \"bg-amber-50\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      border = \"border-amber-200\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      actionPlaybook = \"Involucrar campa\303\261a de goteo orientada a tutoriales de features no utilizados para impulsar la adopci\303\263n de funcionalidades clave.\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { score, description, color, textColor, bgColor, border, actionPlaybook };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }, [tenure, supportTickets, hasContract]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
