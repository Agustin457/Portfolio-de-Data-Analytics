        lines {
          text: "// =========================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// 3. LEAD SCORING SIMULATOR"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// =========================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function LeadScoringSimulator() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [pageViews, setPageViews] = useState<number>(5);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [downloadedAsset, setDownloadedAsset] = useState<boolean>(false);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [companySize, setCompanySize] = useState<\'SMB\' | \'MID\' | \'ENTERPRISE\'>(\'MID\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [hasBusinessEmail, setHasBusinessEmail] = useState<boolean>(true);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const scoring = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let score = 10; // base score"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Behavioural score"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    score += Math.min(30, pageViews * 4); // each page is 4 points up to 30"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (downloadedAsset) score += 20;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Firmographic score"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (companySize === \'ENTERPRISE\') score += 30;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    else if (companySize === \'MID\') score += 15;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    else score += 5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Email authenticity score"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (hasBusinessEmail) score += 15;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    else score -= 10;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Clamp score"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const finalScore = Math.max(0, Math.min(100, score));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let tier: \'A\' | \'B\' | \'C\' | \'D\' = \'D\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let action = \'Noregistrado / Descartar\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let labelColor = \'bg-gray-100 text-gray-700 border-gray-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (finalScore >= 75) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      tier = \'A\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      action = \'Derivar de inmediato a Account Executive para llamada inmediata (Alta Prioridad)\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      labelColor = \'bg-red-50 text-red-700 border-red-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else if (finalScore >= 50) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      tier = \'B\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      action = \'Planificar secuencia drip de automatizaci\303\263n de correos de Producto en ActiveCampaign\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      labelColor = \'bg-amber-50 text-amber-700 border-amber-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else if (finalScore >= 25) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      tier = \'C\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      action = \'Nutrir lead agregando en lista de newsletter cient\303\255fico e invitaciones a webinars\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      labelColor = \'bg-blue-50 text-blue-700 border-blue-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      tier = \'D\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      action = \'Monitorear pasivamente. Marcar como lead fr\303\255o pre-recalificaci\303\263n.\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      labelColor = \'bg-stone-50 text-stone-600 border-stone-200\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { score: finalScore, tier, action, labelColor };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }, [pageViews, downloadedAsset, companySize, hasBusinessEmail]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
