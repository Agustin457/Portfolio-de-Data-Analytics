    replacement_chunks {
      replacement_content: "import { Project, Skill, WorkExperience, Education, Certification } from \'./types\';\n\nexport const USER_INFO = {\n  name: \"Mateo Beliz\303\241n\",\n  title: \"Senior Data & Product Analyst\",\n  subtitle: \"Data Analyst | Business Analyst | Product Analytics\",\n  tagline: \"Transformo silos de datos complejos en narrativas y decisiones de negocio cuantificables. Especializado en optimizaci\303\263n de producto, modelado de embudos y dashboards estrat\303\251gicos que aceleran el crecimiento.\",\n  email: \"mateo.belizan@example.com\", // Will link to standard Gmail or contact\n  linkedin: \"https://linkedin.com/in/mateo-belizan-data\",\n  github: \"https://github.com/mbelizan-data\",\n  cvUrl: \"#\", // Simulated resume download trigger\n  aboutLong: \"Soy analista de datos orientado a resultados con m\303\241s de 5 a\303\261os de trayectoria uniendo el abismo entre la tecnolog\303\255a y los objetivos de negocio. Mi pasi\303\263n radica en estructurar flujos de datos ca\303\263ticos (ETL), dise\303\261ar visualizaciones de alto impacto y extraer \'insights\' accionables que se traducen en valor financiero directo. Tengo experiencia en la toma de decisiones basada en datos (DDR) colaborando estrechamente con equipos de producto, marketing y ejecutivos C-level en metodolog\303\255as \303\241giles. Aplico el an\303\241lisis cuantitativo no solo para reportar el pasado, sino para descifrar el comportamiento del usuario y predecir tendencias que optimizan el ROI.\",\n};\n\nexport const SKILLS: Skill[] = [\n  // An\303\241lisis\n  {\n    name: \"SQL\",\n    category: \"An\303\241lisis\",\n    level: 95,\n    iconName: \"Database\",\n    description: \"Consultas avanzadas (CTE, Window Functions, optimizaci\303\263n de queries, joins multinivel, subqueries complejas) en PostgreSQL, BigQuery y Snowflake.\"\n  },\n  {\n    name: \"Python\",\n    category: \"An\303\241lisis\",\n    level: 90,\n    iconName: \"Code\",\n    description: \"An\303\241lisis exploratorio de datos (EDA) con Pandas, NumPy, modelado predictivo con Scikit-Learn y visualizaciones interactivas mediante Plotly/Seaborn.\"\n  },\n  {\n    name: \"Power BI\",\n    category: \"An\303\241lisis\",\n    level: 92,\n    iconName: \"BarChart3\",\n    description: \"Modelado relacional de datos de estrella, f\303\263rmulas DAX avanzadas, RLS (Row Level Security) y publicaci\303\263n en Cloud Service con actualizaciones autom\303\241ticas.\"\n  },\n  {\n    name: \"Tableau\",\n    category: \"An\303\241lisis\",\n    level: 88,\n    iconName: \"PieChart\",\n    description: \"Creaci\303\263n de historias anal\303\255ticas inmersivas con par\303\241metros din\303\241micos, c\303\241lculos de nivel de detalle (LOD y INCLUDE/EXCLUDE) y dashboards interactivos.\"\n  },\n  {\n    name: \"Excel Avanzado\",\n    category: \"An\303\241lisis\",\n    level: 94,\n    iconName: \"FileSpreadsheet\",\n    description: \"Macros, Power Query (M Language), tablas din\303\241micas complejas, Solver y simulaciones Monte Carlo para planificaci\303\263n financiera \303\241gil.\"\n  },\n\n  // Datos\n  {\n    name: \"Modelado ETL\",\n    category: \"Datos\",\n    level: 87,\n    iconName: \"GitMerge\",\n    description: \"Orquestaci\303\263n de pipelines estructurados con dbt, Apache Airflow y herramientas integradas para nutrir repositorios anal\303\255ticos unificados.\"\n  },\n  {\n    name: \"Data Cleaning & Profiling\",\n    category: \"Datos\",\n    level: 95,\n    iconName: \"Sparkles\",\n    description: \"Detecci\303\263n de anomal\303\255as, imputaci\303\263n de valores faltantes, homogeneizaci\303\263n de formatos heterog\303\251neos y control de calidad robusto del dato.\"\n  },\n  {\n    name: \"Data Visualization\",\n    category: \"Datos\",\n    level: 93,\n    iconName: \"Layout\",\n    description: \"Implementaci\303\263n de las mejores pr\303\241cticas de codificaci\303\263n visual (color, posici\303\263n, escala) para lograr reportes intuitivos y de r\303\241pida interpretaci\303\263n.\"\n  },\n  {\n    name: \"Data Storytelling\",\n    category: \"Datos\",\n    level: 91,\n    iconName: \"BookOpen\",\n    description: \"Traducci\303\263n de m\303\251tricas t\303\251cnicas fr\303\255as en narrativas estrat\303\251gicas para stakeholders no t\303\251cnicos, justificando el camino racional hacia la acci\303\263n.\"\n  },\n  {\n    name: \"KPI Design\",\n    category: \"Datos\",\n    level: 94,\n    iconName: \"Target\",\n    description: \"Definici\303\263n y refinamiento de OKRs, m\303\251tricas principales (North Star Metric), tasas de conversi\303\263n y KPIs espec\303\255ficos de producto y financieros.\"\n  },\n\n  // Negocio\n  {\n    name: \"Product Analytics\",\n    category: \"Negocio\",\n    level: 89,\n    iconName: \"TrendingUp\",\n    description: \"An\303\241lisis de retenci\303\263n (cohorter\303\255a), experimentaci\303\263n A/B testing, segmentaci\303\263n de usuarios y an\303\241lisis de adopci\303\263n de feautures clave.\"\n  },\n  {\n    name: \"Business Analysis\",\n    category: \"Negocio\",\n    level: 92,\n    iconName: \"Briefcase\",\n    description: \"Modelado de procesos de negocio, auditor\303\255a de cuellos de botella de costos operativos y estimaciones de tama\303\261o de mercado direccionable (TAM).\"\n  },\n  {\n    name: \"Agile (Scrum / Kanban)\",\n    category: \"Negocio\",\n    level: 85,\n    iconName: \"Users\",\n    description: \"Planificaci\303\263n de sprints, redacci\303\263n de historias de usuario t\303\251cnicas respaldadas por datos y liderazgo de din\303\241micas anal\303\255ticas semanales.\"\n  },\n  {\n    name: \"Stakeholder Management\",\n    category: \"Negocio\",\n    level: 90,\n    iconName: \"Speech\",\n    description: \"Negociaci\303\263n con directores de producto, ventas y tecnolog\303\255a para alinear los requisitos de recolecci\303\263n de eventos y estructuras de reportes.\"\n  }\n];\n\nexport const PROJECTS: Project[] = [\n  {\n    id: \"sales_dashboard\",\n    name: \"Dashboard de Ventas de Omnicanalidad\",\n    subtitle: \"Consolidaci\303\263n de Canales & Optimizaci\303\263n de Revenue\",\n    description: \"Dise\303\261o y desarrollo de un dashboard anal\303\255tico integral en Power BI y SQL, reuniendo datos de ERP, Web de E-commerce y tiendas f\303\255sicas. Automatiz\303\263 reportajes semanales y revel\303\263 patrones de estacionalidad clave.\",\n    techStack: [\"SQL (BigQuery)\", \"Power BI\", \"Power Query\", \"Excel\", \"Data Modeling\"],\n    impact: \"+14.2% de incremento en margen bruto al identificar productos de alto costo con bajo volumen de rotaci\303\263n en zonas espec\303\255ficas.\",\n    githubUrl: \"https://github.com/mbelizan-data/sales-omnichannel-dashboard\",\n    category: \"Sales\",\n    metrics: [\n      { label: \"Revenue Mensual\", value: \"$412K USD\", trend: \"up\", change: \"+12%\" },\n      { label: \"Precisi\303\263n Pron\303\263stico\", value: \"96.4%\", trend: \"up\", change: \"+3.2%\" },\n      { label: \"Tiempo de Carga Reporte\", value: \"< 2s\", trend: \"down\", change: \"-80%\" }\n    ]\n  },\n  {\n    id: \"churn_analysis\",\n    name: \"Modelo de Retenci\303\263n y An\303\241lisis de Customer Churn\",\n    subtitle: \"Modelo Predictivo y Segmentaci\303\263n de Suscriptores\",\n    description: \"Proyecto avanzado en Python enfocado en predecir la tasa de cancelaci\303\263n de un servicio de suscripci\303\263n SaaS utilizando \303\241rboles de decisi\303\263n y regresi\303\263n log\303\255stica. Se crearon t\303\241cticas defensivas de retenci\303\263n seg\303\272n nivel de riesgo.\",\n    techStack: [\"Python (Pandas, Scikit-Learn)\", \"SQL (PostgreSQL)\", \"Plotly\", \"Cohorts\", \"LTV-modeling\"],\n    impact: \"Reducci\303\263n del Churn general en 2.8 puntos porcentuales (equivalente a salvaguardar ~$180K de MRR anual) mediante disparadores preventivos de retenci\303\263n.\",\n    githubUrl: \"https://github.com/mbelizan-data/customer-churn-prediction\",\n    category: \"Product\",\n    metrics: [\n      { label: \"Tasa de Churn SaaS\", value: \"1.9%\", trend: \"down\", change: \"-2.8%\" },\n      { label: \"LTV Promedio\", value: \"$1,450 USD\", trend: \"up\", change: \"+18%\" },\n      { label: \"Recall del Modelo\", value: \"84%\", trend: \"up\", change: \"+8%\" }\n    ]\n  },\n  {\n    id: \"lead_scoring\",\n    name: \"Lead Scoring Inteligente para B2B\",\n    subtitle: \"Clasificaci\303\263n Anal\303\255tica de Prospectos de Ventas\",\n    description: \"Construcci\303\263n algoritmos de puntuaci\303\263n para priorizar prospectos comerciales que calificaba leads seg\303\272n variables de comportamiento web e interacciones por correo. Los leads de tier A se derivan directamente a ejecutivos clave.\",\n    techStack: [\"Python\", \"SQL Server\", \"Tableau\", \"Segment\", \"Zapier\"],\n    impact: \"Incremento del 22.4% en la tasa de cierre de ventas, logrando que el equipo comercial concentre sus horas en cuentas con 4 veces m\303\241s probabilidad de compra.\",\n    githubUrl: \"https://github.com/mbelizan-data/b2b-lead-scoring-algorithm\",\n    category: \"Business\",\n    metrics: [\n      { label: \"Tasa Cierre Leads\", value: \"31.2%\", trend: \"up\", change: \"+22.4%\" },\n      { label: \"Ciclo de Venta (d\303\255as)\", value: \"14 d\303\255as\", trend: \"down\", change: \"-35%\" },\n      { label: \"Leads Clasificados/d\303\255a\", value: \"1.2k\", trend: \"neutral\", change: \"Estable\" }\n    ]\n  },\n  {\n    id: \"conversion_funnel\",\n    name: \"Embudo de Conversi\303\263n Interactiva de E-commerce\",\n    subtitle: \"Detecci\303\263n de Fricci\303\263n de Checkout y Abandono\",\n    description: \"An\303\241lisis pormenorizado del funnel de registro y proceso de checkout en un e-commerce internacional, localizando que la omisi\303\263n de un campo de cup\303\263n inflaba el dropoff en un 33%. Se impuls\303\263 un redise\303\261o de interfaz.\",\n    techStack: [\"Google Analytics 4\", \"SQL (Snowflake)\", \"Python (EDA)\", \"A/B Testing\", \"Funnels\"],\n    impact: \"+11.5% de incremento en la tasa combinada de checkout completo, impulsando las transacciones generales del portal sin requerir tr\303\241fico adicional.\",\n    githubUrl: \"https://github.com/mbelizan-data/conversion-funnel-checkout-analytics\",\n    category: \"Product\",\n    metrics: [\n      { label: \"Trial-to-Paid Check\", value: \"12.8%\", trend: \"up\", change: \"+11.5%\" },\n      { label: \"Abandono de Carrito\", value: \"48.2%\", trend: \"down\", change: \"-15.4%\" },\n      { label: \"Fricci\303\263n Localizada En\", value: \"Checkout-Paso-2\", trend: \"neutral\", change: \"Resuelto\" }\n    ]\n  },\n  {\n    id: \"financial_analysis\",\n    name: \"Presupuesto y An\303\241lisis de Capacidad Financiera\",\n    subtitle: \"Planificaci\303\263n de Escenarios Operativos & Runway\",\n    description: \"An\303\241lisis exhaustivo del Cash Flow corporativo mediante simulaciones para predecir el runway organizacional ante diferentes variables de crecimiento org\303\241nico y marketing pagado. Identific\303\263 fugas de software redundante.\",\n    techStack: [\"Excel (Solver)\", \"Tableau\", \"Python (Monte Carlo)\", \"Financial Modeling\"],\n    impact: \"Detecci\303\263n de m\303\241s de $45,000 USD de gastos anuales silenciosos en suites de software redundantes y licencias hu\303\251rfanas inactivas.\",\n    githubUrl: \"https://github.com/mbelizan-data/financial-scenarios-runway-simulation\",\n    category: \"Finance\",\n    metrics: [\n      { label: \"Ahorro Identificado\", value: \"$45,200/a\303\261o\", trend: \"up\", change: \"+100%\" },\n      { label: \"Precisi\303\263n Runway\", value: \"98.1%\", trend: \"up\", change: \"+5.1%\" },\n      { label: \"Meses de Runway\", value: \"24 meses\", trend: \"up\", change: \"+3 meses\" }\n    ]\n  }\n];\n\nexport const EXPERIENCES: WorkExperience[] = [\n  {\n    id: \"exp_1\",\n    role: \"Senior Data & Product Analyst\",\n    company: \"InnovaFintech Argentina\",\n    period: \"2024 - Presente\",\n    location: \"Buenos Aires, Argentina (H\303\255brido)\",\n    bullets: [\n      \"Lidero el dise\303\261o de KPI operacionales y de conversi\303\263n para productos financieros de cr\303\251dito \303\241gil, alineando requisitos entre equipos de Producto, Marketing y Tecnolog\303\255a.\",\n      \"Desarroll\303\251 una infraestructura unificada de anal\303\255tica en BigQuery conectando eventos de Mixpanel y bases relacionales, disminuyendo discrepancias de datos de un 11% a menos de 0.5%.\",\n      \"Ide\303\251 y analic\303\251 m\303\241s de 12 experimentos A/B que mejoraron la conversi\303\263n dentro de la App en un 9.3% mediante el redise\303\261o del onboarding.\",\n      \"Automatizo pipelines ETL utilizando dbt e integro reportes interactivos en Power BI con Row Level Security para el acceso seguro de directores regionales.\"\n    ],\n    metricsMoved: [\n      { label: \"Tasa Onboarding\", value: \"+9.3%\" },\n      { label: \"Discrepancia Datos\", value: \"<0.5%\" },\n      { label: \"Tiempo ETL diario\", value: \"-45%\" }\n    ]\n  },\n  {\n    id: \"exp_2\",\n    role: \"Data & Business Analyst\",\n    company: \"Apex Mercado Retail (E-commerce)\",\n    period: \"2022 - 2024\",\n    location: \"Remoto\",\n    bullets: [\n      \"Dise\303\261\303\251 a fondo el dashboard de Omnicanalidad y Stock en Tableau, permitiendo a los gerentes de inventarios detectar quiebres de stock con 48 horas de anticipaci\303\263n.\",\n      \"Redact\303\251 queries complejas de optimizaci\303\263n sobre Snowflake para analizar el comportamiento el\303\241stico del comprador, descubriendo combinaciones cruzadas id\303\263neas para campa\303\261as de Cross-selling.\",\n      \"Estructur\303\251 la limpieza y homogeneizaci\303\263n automatizada con Python de m\303\241s de 4 millones de registros diarios inconsistentes provenientes de 7 pasarelas de pago asociadas.\"\n    ],\n    metricsMoved: [\n      { label: 